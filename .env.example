# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Admin Access
ADMIN_PASSCODE="REPLACE_WITH_SECURE_ADMIN_PASSCODE"
ADMIN_SESSION_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"

# AI Cost Control & Hard Caps
AI_DAILY_REQUEST_LIMIT="150"
AI_EMERGENCY_KILL_SWITCH="false"
AI_MAX_OUTPUT_TOKENS="2048"

# Rate Limiting Controls
RATE_LIMIT_GLOBAL_MAX="120"
RATE_LIMIT_GLOBAL_WINDOW_SEC="60"
RATE_LIMIT_AUTH_MAX="5"
RATE_LIMIT_AUTH_WINDOW_SEC="900"
RATE_LIMIT_AI_MAX="15"
RATE_LIMIT_AI_WINDOW_SEC="600"

# Firebase Client Configuration (Optional overrides)
VITE_FIREBASE_API_KEY="AIzaSy_YOUR_ROTATED_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="tech-sokoni"
